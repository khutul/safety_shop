<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_safety_catalog" model="ir.ui.view">
        <field name="name">product.template.form.safety.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Storefront" name="storefront">
                    <group>
                        <group string="Identification">
                            <field name="brand_id"/>
                            <field name="product_model"/>
                        </group>
                        <group string="Storefront Categories">
                            <field name="storefront_categ_ids" widget="many2many_tags" nolabel="1"/>
                        </group>
                        <group string="Салбар (Industries)">
                            <field name="industry_ids" widget="many2many_tags" nolabel="1"/>
                        </group>
                    </group>
                    <group string="Descriptions">
                        <field name="short_description" placeholder="Товч танилцуулга (жагсаалт/картад харагдана)"/>
                        <field name="long_description" placeholder="Дэлгэрэнгүй тайлбар (бүтээгдэхүүний хуудас)"/>
                    </group>
                </page>
                <page string="Media" name="media">
                    <field name="gallery_image_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="image" widget="image" options="{'size': [64, 64]}"/>
                            <field name="name"/>
                        </list>
                    </field>
                </page>
                <page string="Documents" name="documents">
                    <field name="document_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="doc_type"/>
                            <field name="name"/>
                            <field name="file" widget="binary" filename="file_name"/>
                            <field name="file_name" column_invisible="1"/>
                            <field name="is_public"/>
                        </list>
                    </field>
                </page>
                <page string="Features" name="features">
                    <field name="feature_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="value"/>
                            <field name="icon"/>
                        </list>
                    </field>
                </page>
                <page string="SEO" name="seo">
                    <group>
                        <group string="Publishing">
                            <field name="storefront_published"/>
                            <field name="slug" readonly="1"
                                   placeholder="Нэрнээс автоматаар үүснэ"
                                   help="URL slug барааны нэрнээс автоматаар үүснэ — гараар засах шаардлагагүй."/>
                        </group>
                        <group string="Meta">
                            <field name="meta_title"/>
                        </group>
                    </group>
                    <group string="Meta Description">
                        <field name="meta_description" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Products жагсаалтад Storefront Category / Brand-аар шүүх, бүлэглэх -->
    <record id="view_product_template_search_safety_catalog" model="ir.ui.view">
        <field name="name">product.template.search.safety.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="storefront_categ_ids"/>
                <field name="brand_id"/>
                <filter name="sf_published" string="Вэбэд нийтэлсэн"
                        domain="[('storefront_published', '=', True)]"/>
                <filter name="sf_not_published" string="Нийтлээгүй"
                        domain="[('storefront_published', '=', False)]"/>
                <separator/>
                <filter name="group_storefront_categ" string="Вэб ангилал"
                        context="{'group_by': 'storefront_categ_ids'}"/>
                <filter name="group_brand" string="Брэнд"
                        context="{'group_by': 'brand_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
