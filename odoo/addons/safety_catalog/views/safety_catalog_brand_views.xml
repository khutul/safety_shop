<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_safety_catalog_brand_list" model="ir.ui.view">
        <field name="name">safety.catalog.brand.list</field>
        <field name="model">safety.catalog.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="website"/>
            </list>
        </field>
    </record>

    <record id="view_safety_catalog_brand_form" model="ir.ui.view">
        <field name="name">safety.catalog.brand.form</field>
        <field name="model">safety.catalog.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Honeywell"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="slug" placeholder="e.g. honeywell"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_safety_catalog_brand_search" model="ir.ui.view">
        <field name="name">safety.catalog.brand.search</field>
        <field name="model">safety.catalog.brand</field>
        <field name="arch" type="xml">
            <search string="Brands">
                <field name="name"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_safety_catalog_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">safety.catalog.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_safety_catalog_brands" name="Brands"
              parent="menu_safety_catalog_root" action="action_safety_catalog_brand" sequence="20"/>

</odoo>
