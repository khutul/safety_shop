[options]
; ============================================================
; safety_shop  —  Odoo 19 Community (development)
; Completely isolated from the existing "bodons_erp" project.
;
; TEMPLATE FILE. Copy to odoo.conf and set your own passwords:
;     cp odoo.conf.example odoo.conf
; The real odoo.conf is gitignored (contains secrets).
; ============================================================

; --- Master / admin password (used to create/manage databases) ---
admin_passwd = CHANGE_ME_master_password

; --- Database connection (points to the "db" service in compose) ---
db_host = db
db_port = 5432
db_user = odoo
db_password = CHANGE_ME_db_password

; Only show / allow databases that belong to THIS project.
dbfilter = ^safety_shop.*$
; PRODUCTION: list_db = False (hides /web/database/manager; nginx also blocks it)
list_db = True

; --- Addons ---
addons_path = /mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons

; --- Data / filestore ---
data_dir = /var/lib/odoo

; --- Networking / ports (inside the container) ---
http_port = 8069
gevent_port = 8072
; PRODUCTION: proxy_mode = True (behind nginx; needed so Odoo sees the real
; client IP from X-Forwarded-For — the API rate limiter depends on it)
proxy_mode = False

; --- Developer-friendly settings ---
; PRODUCTION: workers = 2 (or more), max_cron_threads = 1
workers = 0
max_cron_threads = 1
log_level = info
log_handler = :INFO
without_demo = all
